{
  "$schema": "../schema/registry.schema.json",
  "spec": "RFC-0001",
  "protocol_version": "1.0",
  "description": "Machine-readable registries for DLWP/1. RFC-0001 section 11 declares these registries normative; this file is their canonical encoding so that tooling does not have to parse Markdown tables. The conformance verifier reads this file and fails if any vector uses a name that is absent here, or if this file disagrees with RFC-0001.",
  "source_of_truth": "docs/rfc/RFC-0001-wire-protocol.md",

  "message_types": [
    { "code": 1, "name": "HELLO", "direction": "controller_to_agent", "channel": "control", "encrypted": false },
    { "code": 2, "name": "HELLO_ACK", "direction": "agent_to_controller", "channel": "control", "encrypted": false },
    { "code": 3, "name": "AUTH", "direction": "controller_to_agent", "channel": "control", "encrypted": true },
    { "code": 4, "name": "AUTH_OK", "direction": "agent_to_controller", "channel": "control", "encrypted": true },
    { "code": 5, "name": "PING", "direction": "both", "channel": "control", "encrypted": true },
    { "code": 6, "name": "PONG", "direction": "both", "channel": "control", "encrypted": true },
    { "code": 16, "name": "GET_CAPABILITIES", "direction": "controller_to_agent", "channel": "control", "encrypted": true },
    { "code": 17, "name": "CAPABILITIES", "direction": "agent_to_controller", "channel": "control", "encrypted": true },
    { "code": 32, "name": "CHANNEL_OPEN", "direction": "both", "channel": "control", "encrypted": true },
    { "code": 33, "name": "CHANNEL_OPENED", "direction": "both", "channel": "control", "encrypted": true },
    { "code": 34, "name": "CHANNEL_CLOSE", "direction": "both", "channel": "any", "encrypted": true },
    { "code": 48, "name": "VIDEO_START", "direction": "controller_to_agent", "channel": "any", "encrypted": true },
    { "code": 49, "name": "VIDEO_CONFIG", "direction": "agent_to_controller", "channel": "any", "encrypted": true },
    { "code": 50, "name": "VIDEO_FRAME", "direction": "agent_to_controller", "channel": "any", "encrypted": true },
    { "code": 51, "name": "VIDEO_STOP", "direction": "controller_to_agent", "channel": "any", "encrypted": true },
    { "code": 52, "name": "VIDEO_STATS", "direction": "agent_to_controller", "channel": "any", "encrypted": true },
    { "code": 64, "name": "INPUT_TOUCH", "direction": "controller_to_agent", "channel": "any", "encrypted": true },
    { "code": 65, "name": "INPUT_KEY", "direction": "controller_to_agent", "channel": "any", "encrypted": true },
    { "code": 66, "name": "INPUT_TEXT", "direction": "controller_to_agent", "channel": "any", "encrypted": true },
    { "code": 67, "name": "INPUT_SCROLL", "direction": "controller_to_agent", "channel": "any", "encrypted": true },
    { "code": 68, "name": "INPUT_GESTURE", "direction": "controller_to_agent", "channel": "any", "encrypted": true },
    { "code": 80, "name": "SHELL_EXEC", "direction": "controller_to_agent", "channel": "any", "encrypted": true },
    { "code": 81, "name": "SHELL_STDOUT", "direction": "agent_to_controller", "channel": "any", "encrypted": true },
    { "code": 82, "name": "SHELL_EXIT", "direction": "agent_to_controller", "channel": "any", "encrypted": true },
    { "code": 96, "name": "FILE_LIST", "direction": "controller_to_agent", "channel": "any", "encrypted": true },
    { "code": 97, "name": "FILE_LIST_RESULT", "direction": "agent_to_controller", "channel": "any", "encrypted": true },
    { "code": 98, "name": "FILE_PULL", "direction": "controller_to_agent", "channel": "any", "encrypted": true },
    { "code": 99, "name": "FILE_CHUNK", "direction": "agent_to_controller", "channel": "any", "encrypted": true },
    { "code": 100, "name": "FILE_PUSH", "direction": "controller_to_agent", "channel": "any", "encrypted": true },
    { "code": 101, "name": "FILE_RESULT", "direction": "agent_to_controller", "channel": "any", "encrypted": true },
    { "code": 112, "name": "CLIPBOARD_GET", "direction": "controller_to_agent", "channel": "control", "encrypted": true },
    { "code": 113, "name": "CLIPBOARD_SET", "direction": "controller_to_agent", "channel": "control", "encrypted": true },
    { "code": 114, "name": "CLIPBOARD_DATA", "direction": "agent_to_controller", "channel": "control", "encrypted": true },
    { "code": 128, "name": "DEVICE_INFO", "direction": "controller_to_agent", "channel": "control", "encrypted": true },
    { "code": 129, "name": "DEVICE_INFO_RESULT", "direction": "agent_to_controller", "channel": "control", "encrypted": true },
    { "code": 130, "name": "LOG_SUBSCRIBE", "direction": "controller_to_agent", "channel": "any", "encrypted": true },
    { "code": 131, "name": "LOG_ENTRY", "direction": "agent_to_controller", "channel": "any", "encrypted": true },
    { "code": 144, "name": "APP_INSTALL", "direction": "controller_to_agent", "channel": "any", "encrypted": true },
    { "code": 145, "name": "APP_LAUNCH", "direction": "controller_to_agent", "channel": "control", "encrypted": true },
    { "code": 146, "name": "APP_RESULT", "direction": "agent_to_controller", "channel": "any", "encrypted": true },
    { "code": 240, "name": "ERROR", "direction": "both", "channel": "any", "encrypted": true },
    { "code": 241, "name": "SESSION_END", "direction": "both", "channel": "control", "encrypted": true }
  ],
  "message_type_reply_rule": "A message type that is absent from this registry, or present but not enabled by a negotiated capability, MUST be answered with ERR_UNSUPPORTED_MESSAGE and MUST NOT terminate the session.",

  "error_codes": [
    { "code": "ERR_UNSUPPORTED_MESSAGE", "severity": "recoverable" },
    { "code": "ERR_UNSUPPORTED_FEATURE", "severity": "recoverable" },
    { "code": "ERR_UNSUPPORTED_HEADER", "severity": "fatal" },
    { "code": "ERR_FRAME_TOO_LARGE", "severity": "fatal" },
    { "code": "ERR_MALFORMED", "severity": "fatal" },
    { "code": "ERR_VERSION_MISMATCH", "severity": "fatal" },
    { "code": "ERR_HANDSHAKE_MISMATCH", "severity": "fatal" },
    { "code": "ERR_UNAUTHORIZED", "severity": "fatal" },
    { "code": "ERR_PAIRING_REQUIRED", "severity": "fatal" },
    { "code": "ERR_PAIRING_REVOKED", "severity": "fatal" },
    { "code": "ERR_REPLAY_DETECTED", "severity": "fatal" },
    { "code": "ERR_BAD_STATE", "severity": "recoverable" },
    { "code": "ERR_UNEXPECTED_MESSAGE", "severity": "fatal" },
    { "code": "ERR_CHANNEL_UNKNOWN", "severity": "recoverable" },
    { "code": "ERR_CHANNEL_LIMIT", "severity": "recoverable" },
    { "code": "ERR_PERMISSION_DENIED", "severity": "recoverable" },
    { "code": "ERR_NOT_ALLOWED", "severity": "recoverable" },
    { "code": "ERR_TIMEOUT", "severity": "recoverable" },
    { "code": "ERR_BUSY", "severity": "recoverable" },
    { "code": "ERR_RESOURCE_EXHAUSTED", "severity": "recoverable" },
    { "code": "ERR_IO", "severity": "recoverable" },
    { "code": "ERR_INTERNAL", "severity": "fatal" }
  ],
  "error_severity_semantics": {
    "warning": "Informational; the session continues.",
    "recoverable": "Aborts only the affected operation or channel; the session continues.",
    "fatal": "MUST be followed by SESSION_END, and the sender MUST close the connection."
  },

  "capabilities": [
    { "name": "screen.mirror", "meaning": "Video capture and streaming." },
    { "name": "screen.record", "meaning": "On-device recording to a file." },
    { "name": "input.touch", "meaning": "Touch injection." },
    { "name": "input.key", "meaning": "Keycode injection." },
    { "name": "input.text", "meaning": "Text commit injection." },
    { "name": "input.gesture", "meaning": "Multi-step gesture playback." },
    { "name": "clipboard.read", "meaning": "Read device clipboard." },
    { "name": "clipboard.write", "meaning": "Write device clipboard." },
    { "name": "shell.exec", "meaning": "Run allow-listed shell commands." },
    { "name": "file.read", "meaning": "Read files from a scoped directory set." },
    { "name": "file.write", "meaning": "Write files into a scoped directory set." },
    { "name": "log.stream", "meaning": "logcat streaming." },
    { "name": "app.install", "meaning": "APK installation." },
    { "name": "app.launch", "meaning": "Activity/package launch." },
    { "name": "device.info", "meaning": "Device metadata." },
    { "name": "adb.wireless", "meaning": "Agent can keep adbd in TCP mode for the controller." },
    { "name": "compression.deflate", "meaning": "DEFLATE compression of large bodies." },
    { "name": "telemetry.stats", "meaning": "Periodic statistics frames." }
  ],

  "message_type_capability": [
    { "message_type": 48, "capability": "screen.mirror" },
    { "message_type": 49, "capability": "screen.mirror" },
    { "message_type": 50, "capability": "screen.mirror" },
    { "message_type": 51, "capability": "screen.mirror" },
    { "message_type": 52, "capability": "telemetry.stats" },
    { "message_type": 64, "capability": "input.touch" },
    { "message_type": 65, "capability": "input.key" },
    { "message_type": 66, "capability": "input.text" },
    { "message_type": 67, "capability": "input.touch" },
    { "message_type": 68, "capability": "input.gesture" },
    { "message_type": 80, "capability": "shell.exec" },
    { "message_type": 81, "capability": "shell.exec" },
    { "message_type": 82, "capability": "shell.exec" },
    { "message_type": 96, "capability": "file.read" },
    { "message_type": 97, "capability": "file.read" },
    { "message_type": 98, "capability": "file.read" },
    { "message_type": 99, "capability": "file.read" },
    { "message_type": 100, "capability": "file.write" },
    { "message_type": 101, "capability": "file.write" },
    { "message_type": 112, "capability": "clipboard.read" },
    { "message_type": 113, "capability": "clipboard.write" },
    { "message_type": 114, "capability": "clipboard.read" },
    { "message_type": 128, "capability": "device.info" },
    { "message_type": 129, "capability": "device.info" },
    { "message_type": 130, "capability": "log.stream" },
    { "message_type": 131, "capability": "log.stream" },
    { "message_type": 144, "capability": "app.install" },
    { "message_type": 145, "capability": "app.launch" },
    { "message_type": 146, "capability": "app.launch" }
  ],

  "session_end_reasons": [
    "client_shutdown",
    "agent_shutdown",
    "idle_timeout",
    "auth_failed",
    "protocol_error",
    "capture_revoked"
  ],

  "default_limits": {
    "max_frame_bytes": 16777216,
    "max_channels": 8,
    "max_video_width": 1920,
    "max_video_height": 1080,
    "max_video_fps": 60,
    "max_video_bitrate": 16000000,
    "max_file_chunk": 262144,
    "shell_timeout_ms": 30000
  },

  "severity_rules": [
    "A fatal ERROR MUST be followed by SESSION_END and the connection MUST be closed by the sender.",
    "A recoverable ERROR aborts only the affected operation or channel; the session continues.",
    "A warning ERROR is informational; the session continues."
  ]
}
