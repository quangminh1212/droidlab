{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://droidlab.dev/schema/message.schema.json",
  "title": "DLWP/1 Message",
  "description": "The decoded logical form of a DLWP/1 frame: the header plus the cbOR body map. Used by the conformance vectors and by the diagnostic dump. On the wire the body is cbOR with text-string keys (RFC-0001 section 3.2); unknown keys are ignored, never rejected. See the per-message definitions for required keys and defaults.",
  "type": "object",
  "additionalProperties": false,
  "required": ["header", "body"],
  "properties": {
    "header": { "$ref": "frame_header.schema.json" },
    "body": {
      "description": "Decoded cbOR body. An empty body is represented as an empty object.",
      "type": "object",
      "additionalProperties": true
    },
    "name": {
      "description": "Symbolic message name from the RFC-0001 section 4 registry, present in vectors to make them readable.",
      "type": "string",
      "enum": [
        "HELLO",
        "HELLO_ACK",
        "AUTH",
        "AUTH_OK",
        "PING",
        "PONG",
        "PAIR_REQUEST",
        "PAIR_RESPONSE",
        "PAIR_CONFIRM",
        "PAIR_REJECT",
        "PAIR_STATUS",
        "GET_CAPABILITIES",
        "CAPABILITIES",
        "CHANNEL_OPEN",
        "CHANNEL_OPENED",
        "CHANNEL_CLOSE",
        "VIDEO_START",
        "VIDEO_CONFIG",
        "VIDEO_FRAME",
        "VIDEO_STOP",
        "VIDEO_STATS",
        "INPUT_TOUCH",
        "INPUT_KEY",
        "INPUT_TEXT",
        "INPUT_SCROLL",
        "INPUT_GESTURE",
        "SHELL_EXEC",
        "SHELL_STDOUT",
        "SHELL_EXIT",
        "FILE_LIST",
        "FILE_LIST_RESULT",
        "FILE_PULL",
        "FILE_CHUNK",
        "FILE_PUSH",
        "FILE_RESULT",
        "CLIPBOARD_GET",
        "CLIPBOARD_SET",
        "CLIPBOARD_DATA",
        "DEVICE_INFO",
        "DEVICE_INFO_RESULT",
        "LOG_SUBSCRIBE",
        "LOG_ENTRY",
        "APP_INSTALL",
        "APP_LAUNCH",
        "APP_RESULT",
        "ERROR",
        "SESSION_END"
      ]
    }
  }
}
